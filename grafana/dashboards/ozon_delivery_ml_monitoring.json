    {
      "id": 11,
      "type": "barchart",
      "title": "Confusion matrix totals",
      "datasource": {
        "type": "postgres",
        "uid": "ozon_postgres"
      },
      "gridPos": {
        "x": 16,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "ozon_postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 'true_positive' AS result, COALESCE(SUM(true_positive), 0) AS routes_count\n                FROM model_quality_by_day\n\n                UNION ALL\n\n                SELECT 'false_positive' AS result, COALESCE(SUM(false_positive), 0) AS routes_count\n                FROM model_quality_by_day\n\n                UNION ALL\n\n                SELECT 'false_negative' AS result, COALESCE(SUM(false_negative), 0) AS routes_count\n                FROM model_quality_by_day\n\n                UNION ALL\n\n                SELECT 'true_negative' AS result, COALESCE(SUM(true_negative), 0) AS routes_count\n                FROM model_quality_by_day;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
