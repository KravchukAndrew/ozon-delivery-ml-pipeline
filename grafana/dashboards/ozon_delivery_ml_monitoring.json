    {
      "id": 12,
      "type": "table",
      "title": "Top risky routes",
      "datasource": {
        "type": "postgres",
        "uid": "ozon_postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "ozon_postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n                    route_id,\n                    route_date,\n                    zone_id,\n                    weather,\n                    vehicle_type,\n                    num_orders,\n                    ROUND(predicted_late_probability::numeric, 4) AS predicted_late_probability,\n                    target_has_late_orders,\n                    ROUND(target_lateness_rate::numeric, 4) AS target_lateness_rate,\n                    risk_bucket,\n                    prediction_result\n                FROM route_risk_summary\n                ORDER BY predicted_late_probability DESC\n                LIMIT 20;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
