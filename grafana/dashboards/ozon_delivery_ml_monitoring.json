          "datasource": {
            "type": "postgres",
            "uid": "ozon_postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n                    risk_bucket,\n                    COUNT(*) AS routes_count\n                FROM route_risk_summary\n                GROUP BY risk_bucket\n                ORDER BY\n                    CASE risk_bucket\n                        WHEN 'high' THEN 1\n                        WHEN 'medium' THEN 2\n                        WHEN 'low' THEN 3\n                        ELSE 4\n                    END;",
          "refId": "A"
        }
      ],
