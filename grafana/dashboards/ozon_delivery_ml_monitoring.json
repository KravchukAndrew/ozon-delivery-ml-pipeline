    {
      "id": 9,
      "type": "barchart",
      "title": "Routes by risk bucket",
      "datasource": {
        "type": "postgres",
        "uid": "ozon_postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 8,
